# Use the platform operator Clerk instance, not an individual club's issuer.
CLERK_ISSUER=https://your-platform-instance.clerk.accounts.dev
CLERK_SECRET_KEY=
# Optional PEM JWT public key for networkless verification. Literal \n is supported.
CLERK_JWT_KEY=
EXPLORER_ADMIN_SUBJECTS=user_your_platform_operator
EXPLORER_AUTHORIZED_PARTIES=http://localhost:3002

# Explicit control database; never an operational club database.
# MongoDB replica set or Atlas required for multi-document transactions.
EXPLORER_MONGODB_URI=
EXPLORER_CONTROL_DATABASE=app-local-control-kick-playr-ch

# Generate a stable separate 32-byte key (64 hexadecimal characters).
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
# Save it in your secret manager; changing it requires re-encrypting credentials.
EXPLORER_CREDENTIAL_KEY=
HOST=127.0.0.1
PORT=3003
# Optional private JSON mapping exact database/environment/tenant/key references
# to existing wrapping, index and control key files. Paths must be absolute.
EXPLORER_KEY_BINDINGS_FILE=
# Server-only base64 encoding of the existing 32-byte tenant keys.
# In Vercel use Secret variables; never use NEXT_PUBLIC_ names.
FCRWW_WRAPPING_KEY_V1=
FCRWW_INDEX_KEY=
FCRWW_CONTROL_KEY=
FCUSTER_WRAPPING_KEY_V1=
FCUSTER_INDEX_KEY=
FCUSTER_CONTROL_KEY=
# Non-secret JSON binding metadata (variable names only), takes precedence over file.
EXPLORER_KEY_BINDINGS_JSON=
