# Bootstrap verification credentials for the platform operator Clerk instance.
# Issuer, administrator subjects and authorized parties come from encrypted MongoDB configuration.
CLERK_SECRET_KEY=
# Optional PEM JWT public key for networkless verification. Literal \n is supported.
CLERK_JWT_KEY=

# Explicit control database; never an operational club database.
# MongoDB replica set or Atlas required for multi-document transactions.
EXPLORER_MONGODB_URI=
EXPLORER_CONTROL_DATABASE=app-local-real-control-kick-playr-ch
# Existing shared 32-byte wrapping key, canonical base64; do not rotate during configuration migration.
# Decrypts tenantWorkflowConfiguration / runtime:development in the control database.
WORKFLOW_SHARED_WRAPPING_KEY_V1=

# Generate a stable separate 32-byte key (64 hexadecimal characters).
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
# Save it in your secret manager; changing it requires re-encrypting credentials.
EXPLORER_CREDENTIAL_KEY=
HOST=127.0.0.1
PORT=3003
# Key binding metadata is stored in the encrypted explorer.keyBindings section.
# Server-only base64 encoding of the existing 32-byte tenant keys.
# In Vercel use Secret variables; never use NEXT_PUBLIC_ names.
FCRWW_WRAPPING_KEY_V1=
FCRWW_INDEX_KEY=
FCRWW_CONTROL_KEY=
FCUSTER_WRAPPING_KEY_V1=
FCUSTER_INDEX_KEY=
FCUSTER_CONTROL_KEY=

# workflow-real keys: distinct from the historical FCRWW_/FCUSTER_ keys above.
WORKFLOW_REAL_FCRWW_WRAPPING_KEY_V1=
WORKFLOW_REAL_FCRWW_INDEX_KEY=
WORKFLOW_REAL_FCRWW_CONTROL_KEY=
WORKFLOW_REAL_FCUSTER_WRAPPING_KEY_V1=
WORKFLOW_REAL_FCUSTER_INDEX_KEY=
WORKFLOW_REAL_FCUSTER_CONTROL_KEY=

# Club destinations, pinned realms, registered frontend hosts and platform policy
# are read from the encrypted explorer section. There is no JSON/file fallback.

# APP-27 disabled unless explicitly configured. Exact tenant/workspace/APP-origin bindings.
# Secret values live in the named server-only environment variables, never in JSON or NEXT_PUBLIC.
EXPLORER_INVITATION_BINDINGS_JSON=[]
# Example binding: [{"environment":"development","tenantId":"fcrww","issuer":"https://your-club.clerk.accounts.dev","origin":"http://fcrww.localhost:4311","audience":"club-setup","authorizedParties":["http://fcrww.localhost:4311"],"secretKeyEnv":"FCRWW_CLERK_SECRET_KEY"}]
# Explicit platform invitation sender independent of the unprovisioned club. SMTPS only.
EXPLORER_INVITATION_SMTP_URL=
EXPLORER_INVITATION_FROM=
